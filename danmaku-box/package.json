{
  "name": "danmaku-box",
  "displayName": "弹幕收藏夹 DanmakuBox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "直播弹幕收藏管理插件：右键收藏、分组管理、一键回填，数据完全本地（Chrome MV3）",
  "scripts": {
    "prebuild": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "test": "node --test \"tests/**/*.test.ts\" \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "node scripts/check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/chrome": "^0.0.280",
    "@types/node": "^22.0.0",
    "esbuild": "^0.23.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  }
}
